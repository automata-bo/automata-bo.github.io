{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "App.tsx",
    "ChatWidget.tsx",
    "CookieConsent.tsx",
    "NewsletterSignup.tsx",
    "analytics.ts",
    "main.tsx",
    "v2-main.tsx",
    "v2-entry.tsx",
    "vite-env.d.ts"
  ]
}
