{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automata-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "ALLOWED_ORIGIN": "https://automata-bo.github.io"
  },
  "ratelimits": [
    {
      "name": "SESSION_LIMITER",
      "namespace_id": "47401",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "IP_LIMITER",
      "namespace_id": "47402",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
