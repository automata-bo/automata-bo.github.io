{
  "name": "automata-chat-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "pretypecheck": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test:contract": "node scripts/check-assistant-contract.mjs",
    "test:runtime": "node --import tsx --test scripts/test-assistant-runtime.mjs",
    "test:live": "node --import tsx scripts/test-assistant-live.mjs"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.160.1"
  }
}
